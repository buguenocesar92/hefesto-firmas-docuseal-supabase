DB_HOST=REEMPLAZAR
DB_USER=docuseal_app
DB_NAME=postgres
DB_PASSWORD=GENERAR
SECRET_KEY_BASE=GENERAR
ENCRYPTION_SECRET=GENERAR
PUBLIC_URL=https://firmas.example.com
VOLUME_PREFIX=hefesto-firmas
# sslmode del Postgres: verify-full exige CA (certs/ca.crt). disable/require/prefer permiten omitirla.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/certs/ca.crt
SUPABASE_DEDICATED_CONFIRMED=false
SUPABASE_DATA_API_DISABLED=false
INITIAL_SETUP_COMPLETE=false
SMTP_READY=false
SMTP_HOST=mailpit
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=firmas@example.invalid
